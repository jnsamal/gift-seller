{
  "name": "gifty-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e prisma.config.ts prisma/seed.ts playwright.config.ts vitest.config.ts",
    "test": "vitest run --exclude tests/database.test.ts",
    "test:db": "vitest run tests/database.test.ts",
    "test:e2e": "playwright test storefront.spec.ts",
    "test:e2e:production": "playwright test production.spec.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "10.12.0",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
