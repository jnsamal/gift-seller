NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://localhost:3000
# URL-encode username/password. Use separate migration and runtime users in production.
DATABASE_URL=mysql://gifty:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/gifty_dev
TEST_DATABASE_URL=mysql://gifty:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:3308/gifty_test
DATABASE_TLS=false
# Optional path to trusted CA PEM; production requires verified TLS.
DATABASE_CA_FILE=
DB_CONNECTION_LIMIT=5
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Set only after documenting the exact trusted reverse proxy topology.
TRUST_PROXY_HOPS=0
