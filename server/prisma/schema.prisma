generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_REQUESTED
}
enum IdentityType {
  EMAIL
  PHONE
}
enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}
enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model User {
  id String @id @default(cuid()) @db.VarChar(30)
  name String @db.VarChar(120)
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  identities Identity[]
  sessions Session[]
  addresses Address[]
  roles UserRole[]
  orders Order[]
  media MediaAsset[]
}
model Identity {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  type IdentityType
  value String @db.VarChar(254)
  verifiedAt DateTime? @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([type, value])
  @@index([userId])
}
model Session {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}
model OtpChallenge {
  id String @id @default(cuid()) @db.VarChar(30)
  type IdentityType
  identity String @db.VarChar(254)
  purpose String @db.VarChar(30)
  secretHash String @db.Char(64)
  attempts Int @default(0) @db.UnsignedInt
  expiresAt DateTime @db.DateTime(3)
  consumedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([type, identity, purpose, createdAt])
  @@index([expiresAt])
}
model Role {
  id String @id @default(cuid()) @db.VarChar(30)
  code String @unique @db.VarChar(50)
  users UserRole[]
}
model UserRole {
  userId String @db.VarChar(30)
  roleId String @db.VarChar(30)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
  @@index([roleId])
}
model Address {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  recipient String @db.VarChar(120)
  phone String @db.VarChar(20)
  line1 String @db.VarChar(200)
  line2 String? @db.VarChar(200)
  city String @db.VarChar(100)
  state String @db.VarChar(100)
  pincode String @db.Char(6)
  country String @default("IN") @db.Char(2)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Category {
  id String @id @default(cuid()) @db.VarChar(30)
  slug String @unique @db.VarChar(160)
  name String @db.VarChar(120)
  parentId String? @db.VarChar(30)
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products ProductCategory[]
  @@index([parentId])
}
model Product {
  id String @id @default(cuid()) @db.VarChar(30)
  slug String @unique @db.VarChar(160)
  title String @db.VarChar(200)
  description String @db.Text
  status PublicationStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  variants ProductVariant[]
  categories ProductCategory[]
  media ProductMedia[]
  @@index([status, createdAt])
}
model ProductCategory {
  productId String @db.VarChar(30)
  categoryId String @db.VarChar(30)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@id([productId, categoryId])
  @@index([categoryId, productId])
}
model ProductVariant {
  id String @id @default(cuid()) @db.VarChar(30)
  productId String @db.VarChar(30)
  sku String @unique @db.VarChar(80)
  name String @db.VarChar(120)
  pricePaise Int @db.UnsignedInt
  compareAtPaise Int? @db.UnsignedInt
  currency String @default("INR") @db.Char(3)
  active Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory Inventory[]
  orderItems OrderItem[]
  @@index([productId, active])
}
model MediaAsset {
  id String @id @default(cuid()) @db.VarChar(30)
  ownerId String? @db.VarChar(30)
  providerAssetId String @unique @db.VarChar(191)
  publicId String @db.VarChar(191)
  resourceType String @db.VarChar(20)
  deliveryType String @db.VarChar(30)
  format String @db.VarChar(20)
  bytes Int @db.UnsignedInt
  width Int? @db.UnsignedInt
  height Int? @db.UnsignedInt
  durationSeconds Decimal? @db.Decimal(10, 3)
  altText String @db.VarChar(250)
  createdAt DateTime @default(now()) @db.DateTime(3)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  products ProductMedia[]
  @@unique([publicId, resourceType, deliveryType])
  @@index([ownerId])
}
model ProductMedia {
  productId String @db.VarChar(30)
  mediaId String @db.VarChar(30)
  position Int @default(0) @db.UnsignedInt
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([productId, mediaId])
  @@index([mediaId])
}
model FulfilmentLocation {
  id String @id @default(cuid()) @db.VarChar(30)
  code String @unique @db.VarChar(50)
  name String @db.VarChar(120)
  timezone String @default("Asia/Kolkata") @db.VarChar(60)
  inventory Inventory[]
}
model Inventory {
  id String @id @default(cuid()) @db.VarChar(30)
  variantId String @db.VarChar(30)
  locationId String @db.VarChar(30)
  onHand Int @default(0) @db.UnsignedInt
  reserved Int @default(0) @db.UnsignedInt
  version Int @default(0) @db.UnsignedInt
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location FulfilmentLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reservations InventoryReservation[]
  movements InventoryMovement[]
  @@unique([variantId, locationId])
  @@index([locationId])
}
model InventoryMovement {
  id String @id @default(cuid()) @db.VarChar(30)
  inventoryId String @db.VarChar(30)
  delta Int
  reason String @db.VarChar(120)
  createdAt DateTime @default(now()) @db.DateTime(3)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  @@index([inventoryId, createdAt])
}
model InventoryReservation {
  id String @id @default(cuid()) @db.VarChar(30)
  inventoryId String @db.VarChar(30)
  orderId String @db.VarChar(30)
  quantity Int @db.UnsignedInt
  status ReservationStatus @default(ACTIVE)
  expiresAt DateTime @db.DateTime(3)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([inventoryId, orderId])
  @@index([orderId])
  @@index([status, expiresAt])
}
model Order {
  id String @id @default(cuid()) @db.VarChar(30)
  publicId String @unique @db.VarChar(50)
  userId String? @db.VarChar(30)
  checkoutKey String @unique @db.VarChar(120)
  status OrderStatus @default(PENDING_PAYMENT)
  currency String @default("INR") @db.Char(3)
  subtotalPaise Int @db.UnsignedInt
  discountPaise Int @default(0) @db.UnsignedInt
  shippingPaise Int @default(0) @db.UnsignedInt
  taxPaise Int @default(0) @db.UnsignedInt
  totalPaise Int @db.UnsignedInt
  customerSnapshot Json
  addressSnapshot Json
  deliverySnapshot Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
  history OrderStatusHistory[]
  payments Payment[]
  reservations InventoryReservation[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model OrderItem {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @db.VarChar(30)
  variantId String @db.VarChar(30)
  titleSnapshot String @db.VarChar(200)
  skuSnapshot String @db.VarChar(80)
  unitPricePaise Int @db.UnsignedInt
  quantity Int @db.UnsignedInt
  personalisationSnapshot Json
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@index([variantId])
}
model OrderStatusHistory {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @db.VarChar(30)
  status OrderStatus
  note String? @db.VarChar(250)
  createdAt DateTime @default(now()) @db.DateTime(3)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
}
model Payment {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @db.VarChar(30)
  providerOrderId String @unique @db.VarChar(100)
  providerPaymentId String? @unique @db.VarChar(100)
  amountPaise Int @db.UnsignedInt
  status PaymentStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]
  refunds Refund[]
  @@index([orderId])
}
model PaymentEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  providerEventId String @unique @db.VarChar(150)
  paymentId String? @db.VarChar(30)
  eventType String @db.VarChar(80)
  payloadHash String @db.Char(64)
  receivedAt DateTime @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([paymentId])
}
model Refund {
  id String @id @default(cuid()) @db.VarChar(30)
  paymentId String @db.VarChar(30)
  idempotencyKey String @unique @db.VarChar(120)
  providerRefundId String? @unique @db.VarChar(100)
  amountPaise Int @db.UnsignedInt
  status String @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([paymentId])
}
model SiteSetting {
  key String @id @db.VarChar(100)
  value Json
  updatedAt DateTime @updatedAt @db.DateTime(3)
}
model AuditLog {
  id String @id @default(cuid()) @db.VarChar(30)
  actorId String? @db.VarChar(30)
  action String @db.VarChar(100)
  entityType String @db.VarChar(80)
  entityId String @db.VarChar(100)
  requestId String @db.VarChar(50)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
